{
  "name": "dsh-workbuddy-suite",
  "version": "0.1.0",
  "description": "WorkBuddy's experts, skills and connectors as a DSH settings panel: browse and install experts, toggle and import skills, and manage MCP connectors at runtime.",
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workbuddy",
    "experts",
    "skills",
    "mcp",
    "connectors"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "locale",
    "data",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/routes.mjs && node test/client.mjs && node test/entry.mjs",
    "smoke": "node test/smoke.mjs",
    "test:routes": "node test/routes.mjs",
    "test:client": "node test/client.mjs",
    "test:entry": "node test/entry.mjs"
  }
}
